<div class="layout">
  <div class="columns">
    <div class="column">
      <div class="list" data-list-limit="true" data-list-max-height="340" data-list-hidden-count="true" data-list-max-columns="1">
        {% for ligne in trains %}
        <div class="meta">
          <span class="index">{{ligne.line}}</span>
        </div>
        {% endfor %}
        <span class="label">April 22</span>
        <div class="item">
          <div class="meta">
            <span class="index">{{ligne.line}}</span>
          </div>
          <div class="content">
            <span class="title title--small">Michael OOO</span>
            <span class="description">Headed to the Bahamas</span>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">1</span>
          </div>
          <div class="content">
            <span class="title title--small">Monthly Catchup with Dev Team</span>
            <span class="description">Discuss progress and obstacles with the development team</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">10:00 - 11:00</span>
            </div>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">2</span>
          </div>
          <div class="content">
            <span class="title title--small">Meeting with Investors</span>
            <span class="description">Quarterly meeting to review financials and forecasts with key investors</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">18:00 - 13:30</span>
            </div>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">3</span>
          </div>
          <div class="content">
            <span class="title title--small">Gratitude Standup</span>
            <span class="description">Hello everyone! It's officially a good day.</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">15:00 - 16:00</span>
            </div>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">4</span>
          </div>
          <div class="content">
            <span class="title title--small">Meditation Session</span>
            <span class="description">Evening mindfulness practice to reduce stress and improve focus for tomorrow's tasks</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">19:45 - 20:15</span>
            </div>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">5</span>
          </div>
          <div class="content">
            <span class="title title--small">Evening Reading</span>
            <span class="description">Wind down with a good book</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">20:30 - 21:30</span>
            </div>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">6</span>
          </div>
          <div class="content">
            <span class="title title--small">Project Planning</span>
            <span class="description">Outline tasks for tomorrow's sprint</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">21:45 - 22:30</span>
            </div>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">7</span>
          </div>
          <div class="content">
            <span class="title title--small">Review New Marketing Materials</span>
            <span class="description">Final review of the upcoming campaign assets before submission to the client</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">22:45 - 23:30</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="column" data-list-limit="true" data-list-max-height="340" data-list-hidden-count="true" data-list-max-columns="1">
      <div class="list">
        <span class="label">April 23</span>
        <div class="item">
          <div class="meta">
            <span class="index">#</span>
          </div>
          <div class="content">
            <span class="title title--small">Project Kickoff</span>
            <span class="description">Kickoff meeting for the new client project.</span>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">1</span>
          </div>
          <div class="content">
            <span class="title title--small">Quarterly Strategy Meeting</span>
            <span class="description">Extended meeting to review and plan company strategy for the next quarter.</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">08:15 - 13:00</span>
            </div>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">3</span>
          </div>
          <div class="content">
            <span class="title title--small">Client Presentation</span>
            <span class="description">Present the latest product demo to key stakeholders and gather feedback for future iterations.</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">14:30 - 16:00</span>
            </div>
          </div>
        </div>
        <div class="item">
          <div class="meta">
            <span class="index">4</span>
          </div>
          <div class="content">
            <span class="title title--small">Team Happy Hour</span>
            <span class="description">Casual team gathering to celebrate recent project milestones and improve team bonding.</span>
            <div class="flex gap--xsmall">
              <span class="label label--small label--underline">17:30 - 19:00</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <img class="image" src="https://trmnl.com/images/plugins/trmnl--render.svg">
  <span class="title">{{ trmnl.plugin_settings.instance_name }}</span>
  <span class="instance">Description</span>
</div>